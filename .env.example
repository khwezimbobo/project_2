# Copy this file to .env (next to docker-compose.yml) and fill in your own values.
# Never commit .env: it is listed in .gitignore. This example holds placeholders only.

# --- Django ---
# 1 = debug pages on (development only). Must be 0 in production.
DEBUG=0
# A long random string. Generate one with:
#   docker compose run --rm django python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database (MySQL) ---
# DB_HOST is the MySQL service name in docker-compose.yml (not localhost).
DB_NAME=isp_subscription_system
DB_USER=root
# Set this BEFORE the first "docker compose up": MySQL stores it when the volume is first created.
DB_PASSWORD=change-me
DB_HOST=db
DB_PORT=3306

# --- RabbitMQ / Celery ---
RABBITMQ_USER=change-me
RABBITMQ_PASSWORD=change-me
# Must use the same user and password as above; "rabbitmq" is the service name.
CELERY_BROKER_URL=amqp://change-me:change-me@rabbitmq:5672//

# --- Optional: demo data ---
# Password for the staff users created by "python manage.py seed_customers".
# If empty, a random password is generated and printed.
SEED_PASSWORD=
