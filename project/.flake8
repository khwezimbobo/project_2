# flake8 configuration for the whole team (BRD 16.2 uses max-line-length 120).
[flake8]
max-line-length = 120
exclude = migrations,.git,__pycache__,venv,.venv,env,.env,staticfiles
per-file-ignores =
    project/settings/development.py: F401,F403,W292
    project/settings/test.py: F401,F403,E402
    project/settings/base.py: E122,W293
    project/__init__.py: W292
    project/celery.py: W292
